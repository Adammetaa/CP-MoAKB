OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5.6-luna
CONVERSATION_PROVIDER=DISABLED
OPENAI_CONVERSATION_MODEL=gpt-5.6-luna
CONVERSATION_TIMEOUT_MS=15000
VISUAL_PERCEPTION_PROVIDER=DISABLED
OPENAI_VISUAL_MODEL=gpt-5.6-luna
VISUAL_PERCEPTION_TIMEOUT_MS=20000
VISUAL_PERCEPTION_MAX_IMAGE_BYTES=6000000
PORT=4173
PILOT_HOST=127.0.0.1
PILOT_DB_PATH=./data/pilot.sqlite
PILOT_EXPORT_DIR=./data/exports
PILOT_UPLOAD_DIR=./data/uploads
PILOT_ALLOW_LAN=false
PILOT_PROFILE=FIELD_CAPTURE_ALPHA
# Required for a LAN-hosted alpha: PILOT_HOST=0.0.0.0, PILOT_ALLOW_LAN=true,
# and an HTTPS URL supplied by the approved TLS terminator.
PILOT_PUBLIC_BASE_URL=
# Configure at least three independent users. Do not commit real passwords.
PILOT_USERS_JSON=[{"login_id":"field-a","user_id":"field-user-a","password":"CHANGE_ME_A","enabled":true,"display_name":"ผู้ทดสอบ A","role":"FIELD_USER"},{"login_id":"field-b","user_id":"field-user-b","password":"CHANGE_ME_B","enabled":true,"display_name":"ผู้ทดสอบ B","role":"FIELD_USER"},{"login_id":"round0-admin","user_id":"round0-admin","password":"CHANGE_ME_ADMIN","enabled":true,"display_name":"ผู้ดูแลรอบทดสอบ","role":"SPA"}]
